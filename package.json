{
  "name": "prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "predev": "node -e \"require('fs').existsSync('node_modules') || require('child_process').execSync('npm ci --no-audit --no-fund', { stdio: 'inherit' })\"",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "map": "node --disable-warning=ExperimentalWarning tools/screen-map.ts",
    "check": "npm run --silent map && tsc -b && eslint --max-warnings 0 .",
    "share": "node --disable-warning=ExperimentalWarning tools/share.ts",
    "contrast": "node --disable-warning=ExperimentalWarning tools/contrast.ts",
    "a11y": "node --disable-warning=ExperimentalWarning tools/a11y.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "playwright": "1.63.0",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3"
  }
}
